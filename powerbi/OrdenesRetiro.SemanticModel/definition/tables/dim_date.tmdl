table dim_date
	dataCategory: Time

	column date_key
		dataType: dateTime
		isKey
		summarizeBy: none
		sourceColumn: date_key

		annotation UnderlyingDateTimeDataType = Date

	column year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: year

	column month
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: month

	column month_name
		dataType: string
		summarizeBy: none
		sourceColumn: month_name

	column is_business_day
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_business_day

	column month_label
		dataType: string
		summarizeBy: none
		sourceColumn: month_label

	partition dim_date = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(CarpetaDatos & "dim_date.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    SinVacios = Table.TransformColumns(Encabezados, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(SinVacios, {{"date_key", type date}, {"year", Int64.Type}, {"month", Int64.Type}, {"month_name", type text}, {"is_business_day", type logical}}, "en-US"),
				    Extra0 = Table.AddColumn(Tipos, "month_label", each Date.ToText([date_key], "yyyy-MM"), type text)
				in
				    Extra0

